# External base URL, no trailing slash. Required.
SOURCELENS_PUBLIC_URL=http://localhost:3000

# Listen address.
SOURCELENS_BIND=0.0.0.0:3000

# Holds sourcelens.db, secret.key and tmp/. Set to mode 0700 at every start (it contains the indexed
# source code); tmp/ is emptied at every start.
SOURCELENS_DATA_DIR=./data

# Base64 of 32 bytes. If unset, secret.key is created in the data directory on first start and reused.
# SOURCELENS_SECRET_KEY=

# Parallel index jobs.
SOURCELENS_INDEX_CONCURRENCY=2

# Larger files are not indexed.
SOURCELENS_MAX_FILE_BYTES=1048576

# Repository archives (tarballs) larger than this fail the index job. Default 2 GiB.
SOURCELENS_MAX_ARCHIVE_BYTES=2147483648

# Extra allowed browser origin, e.g. the Vite dev server.
# SOURCELENS_DEV_ORIGIN=http://127.0.0.1:5173

# GitHub App from the environment instead of the manifest flow. Set all six or none.
# SOURCELENS_GITHUB_APP_ID=
# SOURCELENS_GITHUB_APP_SLUG=
# SOURCELENS_GITHUB_CLIENT_ID=
# SOURCELENS_GITHUB_CLIENT_SECRET=
# SOURCELENS_GITHUB_WEBHOOK_SECRET=
# SOURCELENS_GITHUB_PRIVATE_KEY_PATH=
